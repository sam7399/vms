# ---------------------------------------------------------------
# Gem Aromatics VMS — self-host environment template
# ---------------------------------------------------------------
# 1. Copy this file to `.env` (same directory as docker-compose.prod.yml)
# 2. Replace every value below with real secrets
# 3. NEVER commit the .env file to git
# ---------------------------------------------------------------

# --- Database -----------------------------------------------------
# Used both by Postgres (init) and by the API (connection string)
POSTGRES_USER=gem
POSTGRES_DB=gem_vms
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- API security -------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_PLUS_CHAR_RANDOM_HEX

# --- Public URLs (what browsers/clients hit) ----------------------
# If using a reverse proxy + domain, set to https://vms.gemaromatics.in
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# --- Branding -----------------------------------------------------
BRAND_CODE=gem
BRAND_FOOTER_TEXT=Gem Aromatics Limited · powered by Personify Crafters

# --- Email (optional but recommended) -----------------------------
# Get from https://resend.com after verifying a sending domain
RESEND_API_KEY=
RESEND_FROM=Gem VMS <vms@gemaromatics.in>

# --- Mobile push (optional) ---------------------------------------
EXPO_ACCESS_TOKEN=

# --- Telegram alerts (optional fallback channel) ------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
