generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========
enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  HR_MANAGER
  SECURITY_GUARD
  RECEPTIONIST
  CONTRACTOR_SUPERVISOR
  EMPLOYEE
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
}

enum VisitStatus {
  PENDING
  APPROVED
  CHECKED_IN
  CHECKED_OUT
  REJECTED
  BLACKLISTED
}

// ========== MODELS ==========

model Organization {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(255)
  branches    Branch[]
  contractors Contractor[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Branch {
  id             String    @id @default(uuid())
  organizationId String
  name           String    @db.VarChar(255)
  location       String    @db.VarChar(500)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  visits         Visit[]
  attendance     Attendance[]
  shifts         Shift[]
  parkingSlots   ParkingSlot[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([name])
}

model Shift {
  id          String       @id @default(uuid())
  branchId    String
  name        String       @db.VarChar(100)  // "Morning", "Evening", "Night"
  startTime   String       @db.VarChar(5)    // "06:00"
  endTime     String       @db.VarChar(5)    // "14:00"
  isActive    Boolean      @default(true)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignments WorkerShift[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([branchId, name])
  @@index([branchId])
}

model WorkerShift {
  id        String   @id @default(uuid())
  workerId  String
  shiftId   String
  assignedAt DateTime @default(now())

  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  shift     Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([workerId, shiftId])
  @@index([workerId])
  @@index([shiftId])
}

model ParkingSlot {
  id        String   @id @default(uuid())
  branchId  String
  label     String   @db.VarChar(50)   // "A-12"
  zone      String?  @db.VarChar(50)   // "Visitor", "Staff", "Loading"
  isActive  Boolean  @default(true)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visits    Visit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, label])
  @@index([branchId])
}

model User {
  id           String    @id @default(uuid())
  branchId     String
  email        String    @unique @db.VarChar(255)
  passwordHash String
  fullName     String    @db.VarChar(255)
  role         Role
  phone        String?   @db.VarChar(20)
  faceData     Bytes?    // Face embedding vector for facial recognition
  isActive     Boolean   @default(true)
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visitsHosted Visit[]   @relation("HostToVisit")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchId])
  @@index([email])
  @@index([role])
}

model Visitor {
  id             String    @id @default(uuid())
  fullName       String    @db.VarChar(255)
  phone          String    @unique @db.VarChar(20)
  email          String?   @db.VarChar(255)
  company        String?   @db.VarChar(255)
  documentType   DocumentType
  documentNumber String    @db.VarChar(100)
  faceData       Bytes?    // raw photo (JPEG)
  faceEmbedding  Bytes?    // face-api.js Float32Array(128) serialized
  isBlacklisted  Boolean   @default(false)
  visits         Visit[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([phone])
  @@index([isBlacklisted])
}

model Visit {
  id             String      @id @default(uuid())
  visitorId      String
  branchId       String
  hostId         String
  purpose        String      @db.VarChar(500)
  status         VisitStatus @default(PENDING)
  expectedEntry  DateTime
  actualEntry    DateTime?
  actualExit     DateTime?
  vehicleNumber  String?     @db.VarChar(50)
  qrCodeToken    String      @unique @db.VarChar(500)
  parkingSlotId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  visitor        Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  host           User        @relation("HostToVisit", fields: [hostId], references: [id], onDelete: Restrict)
  parkingSlot    ParkingSlot? @relation(fields: [parkingSlotId], references: [id], onDelete: SetNull)
  materialPasses MaterialGatePass[]

  @@index([visitorId])
  @@index([branchId])
  @@index([hostId])
  @@index([status])
  @@index([expectedEntry])
  @@index([parkingSlotId])
}

enum PassDirection {
  IN
  OUT
}

model MaterialGatePass {
  id            String        @id @default(uuid())
  visitId       String
  direction     PassDirection
  description   String        @db.VarChar(1000)
  quantity      Int           @default(1)
  serialNumber  String?       @db.VarChar(200)
  recordedBy    String?       @db.VarChar(255) // free text — user name / "kiosk" / "guard X"
  createdAt     DateTime      @default(now())

  visit         Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([direction])
  @@index([createdAt])
}

model Contractor {
  id             String    @id @default(uuid())
  organizationId String
  companyName    String    @db.VarChar(255)
  gstNumber      String    @unique @db.VarChar(50)
  complianceScore Float    @default(100.0)
  workers        Worker[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([gstNumber])
}

model Worker {
  id             String    @id @default(uuid())
  contractorId   String
  fullName       String    @db.VarChar(255)
  phone          String    @db.VarChar(20)
  documentType   DocumentType
  documentNumber String    @db.VarChar(100)
  skillCategory  String    @db.VarChar(100)
  faceData       Bytes?
  faceEmbedding  Bytes?    // face-api.js Float32Array(128) serialized
  medicalExpiry  DateTime
  policeVerified Boolean   @default(false)
  isActive       Boolean   @default(true)
  pfNumber       String?   @db.VarChar(50)
  esicNumber     String?   @db.VarChar(50)
  hourlyRate     Float?
  qrCodeToken    String?   @unique @db.VarChar(500)  // permanent gate-scan token
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  attendance     Attendance[]
  shifts         WorkerShift[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contractorId])
  @@index([isActive])
}

model Attendance {
  id         String    @id @default(uuid())
  workerId   String
  branchId   String
  checkIn    DateTime  @default(now())
  checkOut   DateTime?
  gateId     String    @db.VarChar(100)
  worker     Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([branchId])
  @@index([checkIn])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @db.VarChar(100)   // userId from JWT, or null for anon
  actorEmail String?  @db.VarChar(255)
  actorRole  String?  @db.VarChar(50)
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(500)
  status     Int
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([path])
}
